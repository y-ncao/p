idth: 2.005em; height: 0.583em; background-size: contain; background-position: 0% 0%;" data-mediatype="2"><span class="grad"></span></div><div class="item txt" style="top: 9.26em; left: 1.16em; width: 2.05em; height: 0.92em;"><div class="txt-inner autosize" style="padding: 0.05em; font-size: 0.734375em;"><div style="font-size: 0.18em; font-family: Abel;"><b style="font-size: 1.39em;"><span class="token tkn-sUserName"></span></b></div><div style="font-size: 0.18em; font-family: Abel;"><b style="font-size: 1.39em;"><span class="token tkn-sGroupName"></span></b></div><div style="font-size: 0.15em; font-family: Abel;"><span class="token tkn-sGroupFullAddress"></span></div><div style="font-size: 0.18em; font-family: Abel;"><span class="token tkn-sPhone"></span></div><div style="font-size: 0.18em; font-family: Abel;"><span class="token tkn-sEmail"></span></div><div style="font-size: 0.18em; font-family: Abel;"><span class="token tkn-sWebsite"></span></div></div></div><div class="item txt vmiddle" style="top: 10.156em; left: 0.61em; width: 6.78em; height: 0.269em;"><div class="txt-inner autosize" style="padding: 0.05em;"><div style="font-size: 0.13em; text-align: center; font-family: Abel;">See more information at&nbsp;<span class="token tkn-sSiteUrl"></span> &nbsp; All information deemed reliable but not guaranteed.</div></div></div><div class="item img media qr" style="top: 8.932em; left: 6.566em; width: 1.142em; height: 1.126em; background-position: 100% 99.928%; background-size: 185.934% 107.472%;" data-mediatype="4"><span class="grad"></span></div><div class="item shp" data-shape="equalhousing" style="fill: rgb(0, 0, 0); left: 7.7em; top: 10.2em; width: 0.3em; height: 0.3em;"></div><div class="item txt" style="left: 0em; top: 10.1em; width: 1.05em; height: 0.4em;"><div class="txt-inner autosize" style="text-align: justify; padding: 0em;"><div style="font-size: 0.11em; font-family: Abel;"><span class="token tkn-sDisclaimer"></span></div></div></div><div class="item txt