<!--***TEMPLATES BELOW***-->

<script id="bannerheadtemplate" type="text/x-handlebars-template">
	<div style="position: relative;">
		{{#if (and allowMk (and (ne previewOnly true) (or (ne mkUpgradeCost null) (eq marketingKit true))))}}

			{{#if (and (ne previewOnly true) (or (isnull download.[0].sLicense) (eq download.[0].nLicensePolicy "0")))}}
				<!--Logic above: if we need to delay this due to there being a license and it being a pop-up-->
				<scr{{!}}ipt>
					window.setTimeout('$(\'.marketlink\').show().animate({right: \'-1px\'}, 1250);', 250);
				</scr{{!}}ipt>
			{{/if}}
			
		{{/if}}
		<div class="banner-wrapper">
			{{#if firstPublicPhoto}}
				<div class="banner-bg picbox hidenomedia fsize" hd-media="{{firstPublicPhoto.sSizes}}" hd-mediaext="{{firstPublicPhoto.sExtension}}" hd-mediatype="{{firstPublicPhoto.nMediaTypeID}}"></div>
			{{/if}}
			<div class="banner-container">
				{{#if (and (ne previewOnly true) (or download.0.sUserPhotoSizes download.0.sCoUserPhotoSizes))}}
					<div class="banner-user-photos" style="z-index: 2; position: relative;">
						<div style="border: 2px solid #6f6b6c; display: inline-block;">
							<div class="user-photo picbox" hd-media="{{download.0.sUserPhotoSizes}}" hd-mediaext="{{download.0.sUserPhotoExt}}" style=""></div>
						</div>
						{{#if download.0.sCoUserPhotoSizes}}
							<div style="border: 2px solid #6f6b6c; display: inline-block; margin-left: 2.5em;">
								<div class="user-photo picbox" hd-media="{{download.0.sCoUserPhotoSizes}}" hd-mediaext="{{download.0.sCoUserPhotoExt}}" style=""></div>
							</div>
						{{/if}}
					</div>
				{{/if}}
				<div style="display: block; z-index: 2; color: #{{#if firstPublicPhoto}}FFF{{else}}000{{/if}};">
					{{#if (ne previewOnly true)}}
						<div class="title">MEDIA DOWNLOAD CENTER</div>
					{{else}}
						<div class="title" style="margin-top: 0;">PROPERTY OWNER PREVIEW</div>
						<div class="title2">COURTESY OF {{download.0.sBrandName}}</div>
						<div class="dotted-line">..........................................................................................................................................................................................</div>
					{{/if}}
					<div class="sub-title">{{download.0.sAddress}}{{#if download.0.sAddress2}} {{download.0.sAddress2}}{{/if}}, {{download.0.sCity}}, {{download.0.sState}} {{download.0.sZipCode}}</div>
					{{#if download.0.sUserName}}<div class="sub-title">{{download.0.sUserName}}{{#if download.0.sGroupName}}, {{download.0.sGroupName}}{{/if}}</div>{{/if}}
					{{#if download.0.sCoUserName}}<div class="sub-title">{{download.0.sCoUserName}}{{#if download.0.sCoGroupName}}, {{download.0.sCoGroupName}}{{/if}}</div>{{/if}}
					{{#if (eq previewOnly true)}}
						<div class="dotted-line" style="margin-top: 0.75em;">...................................................................................................................................</div>
						<div class="personal-use-only" style="">This Preview is for Personal Purposes Only</div>
					{{/if}}
				</div>
			</div>
		</div>
	</div>
	<div style="background-color: #FFF; width: 100vw; height: 0.625em;"></div>
</script>

<script id="wakeuptemplate" type="text/x-handlebars-template">
	{{#if (eq archivedMedia true)}}
		<div style="position: relative;">
			<scr{{!}}ipt>

				var wakeupIndex = 0;
				var wakeupCount = 0;

				function wakeupAwake() {}

				function wakeupComplete() {
					console.log('complete');
					document.location = document.location;
				}

				function wakeupList(l) {
					wakeupCount = l.split(',').length;
				}

				function wakeupRestore(i, t) {
					wakeupIndex++;
					console.log(wakeupIndex + ' / ' + wakeupCount);
					$('.wakeup .progress').css({ width: Number((wakeupIndex / wakeupCount) * 100).toFixed(1) + '%' });
				}

			</scr{{!}}ipt>
			<div class="hdr-container">
				<div class="hdr"><span style="color: var(--brand-color);">WAKING UP</span> MEDIA</div>
				<center class="chevron-container">
					<div class="chevron"></div>
					<div class="chevron"></div>
				</center>
			</div>
			<div class="nolasso wakeuptop" style="">
				<div class="fa-solid fa-house wakeup-house"><i class="far fa-snooze wakeup-snooze"></i></div>
				<div class="wakeup">
					This Site contains media that has been put to sleep.<br />
					<div style="margin-top: 1em;">Give us a moment while we wake up your media...</div>
					<div class="wakeupbar" style=""><div class="progress" style="background: var(--brand-color); width: 1px; height: 10px; margin: 1px;"></div></div>
				</div>
			</div>
		</div>
		<!--Would this work via Handlebars or do we need to keep the iframe out of the templates/compiles? Hmm. Wish I could test archived media locally.-->
		<iframe src="/media/wakeup.asp?nSiteID={{siteId}}" frameborder="0" style="position: absolute; width: 1px; height: 1px;"></iframe>
	{{/if}}
</script>

<script id="brightmlstemplate" type="text/x-handlebars-template">
	{{#if hasBrightMls}}
		<div class="hdr-container">
			<div class="hdr">{{#if (ne previewOnly true)}}UPLOAD TO {{/if}}<span style="color: var(--brand-color);">BRIGHTMLS</span></div>
			<center class="chevron-container">
				<div class="chevron"></div>
				<div class="chevron"></div>
			</center>
		</div>
		<div class="brightmls-boxes-container">
			<div class="brightmls-boxes">
				<div class="brightmls-box-container" style="">
					<div class="brightmls-box-pic" style="">
						<img src="/art/social/logoBright.png" style="width: 50%; max-width: 318px; max-height: 134px;" />
					</div>
					<div class="brightmls-box-middle" style="">
						<div class="brightmls-pic-title" style="">Upload the photos, floor plans, embedded media and Property Site link to Bright MLS.</div>
					</div>
					<div class="brightmls-box-bottom" style="">
						{{#if brightMedia.length}}
							<div class="brightmls-dl-link">
							{{#if marketingKit}}
								<div style="color: #888; font-size: 0.8em; padding: 1em 0 0 0;">Unbranded Property Website</div>
								<label for="bm0" class="lbl-cb-bright">
								<input class="cb-bright" type="checkbox" name="sBrightMediaList" id="bm0" value="0" checked="checked" onclick="brightCheck();" />
								<svg width="16" height="16" viewBox="-4 -4 24 24" aria-hidden="true" focusable="false">
									<rect class="checkbox__bg" width="24" height="24" x="-4" y="-4" stroke="currentColor" fill="#FFF" stroke-width="0" rx="3" ry="3"></rect>
									<polyline class="checkbox__checkmark" points="2,7 5,12 14,3" stroke="transparent" stroke-width="2" fill="none"></polyline>
								</svg>
								<span class="brightmls-item">&nbsp;{{brightMedia.[0].sSiteUrlIdx}}</span>
								</label><br />
							{{/if}}
							{{#each brightMedia}}
								{{#if (eq nMediaTypeID 8)}}
									{{#if firstEmbed}}<div style="color: #888; font-size: 0.8em; padding: 1em 0 0 0;">Unbranded Special URLs</div>{{/if}}

								<label for="bm{{nMediaID}}" class="lbl-cb-bright">
								<input class="cb-bright" type="checkbox" name="sBrightMediaList" id="bm{{nMediaID}}" value="{{nMediaID}}" checked="checked" onclick="brightCheck();" />
								<svg width="16" height="16" viewBox="-4 -4 24 24" aria-hidden="true" focusable="false">
									<rect class="checkbox__bg" width="24" height="24" x="-4" y="-4" stroke="currentColor" fill="#FFF" stroke-width="0" rx="3" ry="3"></rect>
									<polyline class="checkbox__checkmark" points="2,7 5,12 14,3" stroke="transparent" stroke-width="2" fill="none"></polyline>
								</svg>
								<span class="brightmls-item">&nbsp;{{sMediaName}}</span>
								</label><br />
								{{/if}}
							{{/each}}
							{{#if (ne brightMedia.[0].sBMPhotoList null)}}
								<div style="color: #888; font-size: 0.8em; padding: 1em 0 0 0;">Site Media</div>

								<label for="bmSiteMedia" class="lbl-cb-bright">
								<input class="cb-bright" type="checkbox" name="sBrightMediaList" id="bmSiteMedia" value="{{brightMedia.[0].sBMPhotoList}}" checked="checked" onclick="brightCheck();" />
								<svg width="16" height="16" viewBox="-4 -4 24 24" aria-hidden="true" focusable="false">
									<rect class="checkbox__bg" width="24" height="24" x="-4" y="-4" stroke="currentColor" fill="#FFF" stroke-width="0" rx="3" ry="3"></rect>
									<polyline class="checkbox__checkmark" points="2,7 5,12 14,3" stroke="transparent" stroke-width="2" fill="none"></polyline>
								</svg>
								<span class="brightmls-item">&nbsp;Photos & JPG Floor Plans</span>
								</label><br />
							{{/if}}
							{{#each brightMedia}}
								{{#if (and (ne nPDFMode 3) (eq nMediaTypeID 7))}}
									{{#if firstAttachment}}<div style="color: #888; font-size: 0.8em; padding: 1em 0 0 0;">PDF Floor Plans / Attachments</div>{{/if}}

								<label for="bm{{nMediaID}}" class="lbl-cb-bright">
								<input class="cb-bright" type="checkbox" name="sBrightMediaList" id="bm{{nMediaID}}" value="{{nMediaID}}" checked="checked" onclick="brightCheck();" />
								<svg width="16" height="16" viewBox="-4 -4 24 24" aria-hidden="true" focusable="false">
									<rect class="checkbox__bg" width="24" height="24" x="-4" y="-4" stroke="currentColor" fill="#FFF" stroke-width="0" rx="3" ry="3"></rect>
									<polyline class="checkbox__checkmark" points="2,7 5,12 14,3" stroke="transparent" stroke-width="2" fill="none"></polyline>
								</svg>
								<span class="brightmls-item">&nbsp;{{sMediaName}}.{{sExtension}}</span>
								</label><br />
								{{/if}}
							{{/each}}
							</div>
						{{/if}}
						{{#if brightImport.length}}
							<div class="brightmls-dl-link">
								<a href="#" onclick="$(this).hide(); $('.bright-manifests').show();" class="a-single">This listing been uploaded {{brightImport.length}} time{{#if (gt brightImport.length 1)}}s{{/if}}</a>
								<div class="bright-manifests" style="display: none; line-height: 1.2em; margin-bottom: 1em;">
									<div style="font-size: 0.85em; font-weight: 700;">Sent Manifest(s)</div>
									<ul style="margin: 0;">
									{{#each brightImport}}
										<li>{{sKey}}</li>
									{{/each}}
									</ul>
								</div>
							</div>
						{{/if}}
						<button href="#" name="BrightUpload" class="brightmls-btn-upload btn" onclick="brightUpload(); return false;">> Upload to Bright MLS Now</button>
					</div>	
				</div>
			</div>
		</div>
		<div class="general-divider"></div>
	{{/if}}
</script>

<script id="downloadalltemplate" type="text/x-handlebars-template">
	{{#if (ne previewOnly true)}}
		<div class="hdr-container">
			<div class="hdr"><span class="mkit-widget-title">DOWNLOAD <span style="color: var(--brand-color);">ALL PHOTOS</span></span>{{#if (ne allowMk false)}}<span class="mkit-widget-container">
						<div style="position: absolute; display: flex;">
							<div>
								<div class="message" onclick="gotoMarketingKit();">
									{{#if marketingKit}}Your Marketing Kit is Ready.{{else}}Your Marketing Kit is Waiting.{{/if}}<br />
									Take a Look &gt;&gt;
								</div>
							</div>
							<div style="position: relative; top: -40px; left: -2px;">
								<img src="/art/public/iphone-winterface.png" class="phone-frame" onclick="gotoMarketingKit();">
								<video src="/art/public/MKitWidget-02.mp4" class="phone-content" autoplay muted loop playsinline></video>
							</div>
						</div>
					</span>{{/if}}</div>
			<center class="chevron-container">
				<div class="chevron"></div>
				<div class="chevron"></div>
			</center>
		</div>
		<div class="da-boxes">
			{{#each downloadSizes}}
				{{> dapBoxPartialTemplate photo1=@root.firstPublicPhoto photo2=@root.secondPublicPhoto photo3=@root.thirdPublicPhoto}}
			{{/each}}
			<div class="da-box-container" style="">
				<div class="da-box-top" style="">
					<div class="up da-box-hdr" style="">CUSTOM</div>
					<div class="up da-box-subhdr" style="">ENTER ANY SIZE</div>
				</div>
				<div class="da-box-bottom" id="custom-size" style="">
					<div class="da-box-custom-values" style="">
							<div style="display: flex; flex-direction: row; align-items: center;">
								<div class="f" style="display: inline-block;"><input type="text" name="w" value="800" class="custom x" style="" hd-hint="Length (PX)" hd-hint-noshrink onkeyup="checkCustomDL();" onblur="checkCustomDL();" /></div>
								<div style="height: 42px; padding: 10px; font-size: 1.25em; font-weight: 900;">X</div>
								<div class="f" style="display: inline-block;"><input type="text" name="h" value="600" class="custom y" style="" hd-hint="Height (PX)" hd-hint-noshrink onkeyup="checkCustomDL();" onblur="checkCustomDL();" /></div>
							</div>
					</div>
				</div>
				<div class="downallbtn btn custom" onclick="if(getCustomUrl().length) { window.open(getCustomUrl(), 'download'); } return false;">
					<div class="notch"></div>
					<div>
						<i class="fak fa-eric-download-arrow-to-bracket" style="color: var(--icon-dark-override); font-size: 1.25em; margin-right: 0.3em;"></i>
						DOWNLOAD ALL PHOTOS
					</div>
				</div>
			</div>
		</div>
		<div class="da-separator" style=""></div>
	{{/if}}
</script>

<script id="dapCollagePartialTemplate" type="text/x-handlebars-template">
	<div class="" style="position: relative; display: flex; width: 18.25em; height: 14.625em; justify-content: center; align-items: center;">
		<div class="picbox da-box-image" hd-media="{{photo3.sSizes}}" hd-mediaext="{{photo3.sExtension}}" hd-mediatype="{{photo3.nMediaTypeID}}" style="width: 17.5em; height: 11.625em; top: 0;"></div>
		<div class="picbox da-box-image middle" hd-media="{{photo2.sSizes}}" hd-mediaext="{{photo2.sExtension}}" hd-mediatype="{{photo2.nMediaTypeID}}" style="width: 14.375em; height: 9.5em; top: 3.625em;"></div>
		<div class="picbox da-box-image front" hd-media="{{photo1.sSizes}}" hd-mediaext="{{photo1.sExtension}}" hd-mediatype="{{photo1.nMediaTypeID}}" style="width: 11.375em; height: 7.5em; top: 6.375em;"></div>
		<div class="da-box-text-over" style="">{{#if dimSize}}{{dimSize}}{{else}}ORIGINAL{{/if}}<br />SIZE</div>
	</div>
</script>


<script id="dapBoxPartialTemplate" type="text/x-handlebars-template">
	<div class="da-box-container" style="">
		<div class="da-box-top" style="">
			<div class="up da-box-hdr" style="">{{title}}</div>
			<div class="up da-box-subhdr" style="">{{subTitle}}</div>
		</div>
		<div class="da-box-bottom" style="">
			{{> dapCollagePartialTemplate }}
		</div>
		<div class="btn downallbtn" onclick="window.open('{{zipUrl}}', 'download');">
			<div class="notch"></div>
			<div>
				<i class="fak fa-eric-download-arrow-to-bracket" style="color: var(--icon-dark-override); font-size: 1.25em; margin-right: 0.3em;"></i>
				DOWNLOAD ALL PHOTOS</div>
		</div>
	</div>
</script>

<script id="downloadindividualtemplate" type="text/x-handlebars-template">
	{{#if download.length}}
		<div class="hdr-container">
			<div class="hdr">{{#if (ne previewOnly true)}}DOWNLOAD {{/if}}<span style="color: var(--brand-color);">INDIVIDUAL PHOTOS</span></div>
			<center class="chevron-container">
				<div class="chevron"></div>
				<div class="chevron"></div>
			</center>
		</div>
		<div class="di-boxes-container">
			<div class="di-boxes">
				{{#each download}}
					{{#if (lt nMediaTypeID 9)}}
						{{> diBoxPartialTemplate this}}
					{{/if}}
				{{/each}}
				{{#if (ne @root.previewOnly true)}}
				{{/if}}
			</div>
		</div>
		<div class="di-dl-selected-container">
			<div class="di-dl-selected">
				<div class="di-sub-hdr">YOUR SELECTED PHOTOS</div>
				<div class="di-sel-divider"></div>
				<div class="downselcontainer">
					{{#each downloadSizes}}
						<div class="downselbtn btn disabled" onclick="zipSelected('{{zipSelUrl}}');">
							<div>
								<i class="fak fa-eric-download-arrow-to-bracket" style="color: inherit; font-size: 1.25em; margin-right: 0.3em;"></i>
								{{downSelName}}
							</div>
						</div>
					{{/each}}
				</div>
			</div>
		</div>
	{{/if}}
</script>

<script id="diBoxPartialTemplate" type="text/x-handlebars-template">
	<div class="di-box-container" style="">
		<div class="di-box-pic" style="">
			<div class="picbox preview xdi-box-image" hd-mid="{{nMediaID}}" hd-media="{{sSizes}}" hd-mediaext="{{sExtension}}" hd-mediatype="{{nMediaTypeID}}" {{#if (lt (null2zero nOrigWidth) (null2zero nOrigHeight))}}hd-mediafit {{/if}}style="width: 395px; height: 270px; top: 0; position: absolute;{{#if (eq nStatusID 0)}} opacity: 0.3;{{/if}}"
				{{#if (ne @root.payBalance true)}} onclick="showPreview('<div class=&quot;picbox&quot; hd-media=&quot;{{sSizes}}&quot; hd-mediaext=&quot;{{sExtension}}&quot; hd-mediafit style=&quot;width: 100%; height: 100%;&quot;>{{#if (eq @root.previewOnly true)}}<div><img src=&quot;/art/protected.jpg&quot; class=&quot;protected&quot; /></div>{{/if}}></div>', {{nMediaID}});"{{/if}}
				>
				{{#if (eq @root.previewOnly true)}}<div><img src="/art/protected.jpg" class="protected" /></div>{{/if}}
			</div>
			{{#if (ne @root.previewOnly true)}}
				<label for="mid{{nMediaID}}" class="lbl-cb-photo">
					<input class="cb-photo" type="checkbox" id="mid{{nMediaID}}" name="nMediaID" value="{{nMediaID}}" style="" onchange="updateCheckbox();" />
					<svg width="32" height="32" viewBox="-4 -4 39 39" aria-hidden="true" focusable="false">
						<rect class="checkbox__bg" width="39" height="39" x="-4" y="-4" stroke="currentColor" fill="#FFF" stroke-width="0" rx="6" ry="6"></rect>
						<polyline class="checkbox__checkmark" points="4,14 12,23 28,5" stroke="transparent" stroke-width="4" fill="none"></polyline>
					</svg>
				</label>
			{{/if}}
		</div>
		<div class="di-box-middle" style="">
			<div class="di-box-middle-container">
				<div class="di-pic-num">{{add @index 1}}</div>
				<div class="di-pic-title">{{truncate sMediaName 50}}</div>
			</div>
		</div>
		{{#if (ne @root.previewOnly true)}}
			<div class="di-box-bottom" style="">
				<div class="di-dl-link">
				{{#each @root.downloadSizes}}
					<a href="{{#if (eq multiDLID "idpq")}}//media.hd.pics/{{../sOrigMediaKey}}.{{../sExtension}}?filename={{encuri ../sFileName}}.{{../sExtension}}{{else}}sized.aspx?k={{../sOrigMediaKey}}&e={{../sExtension}}&n={{encuri ../sFileName}}.{{../sExtension}}{{singleUrlAppend}}{{/if}}" class="a-single" style="">
					<i class="fak fa-eric-download-arrow-to-bracket" style="color: var(--brand-color); font-size: 1em; margin-right: 0.3em;"></i>
					{{#if (eq multiDLID "idpq")}}
						ORIGINAL SIZE
					{{else}}
						{{title}}
					{{/if}}
					</a>
				{{/each}}
				</div>
			</div>	
		{{/if}}
	</div>
</script>


<script id="downloadvideostemplate" type="text/x-handlebars-template">
	{{#if (and video.length (eq hasVideo true))}}
		<div class="hdr-container">
			<div class="hdr">{{#if (ne previewOnly true)}}DOWNLOAD {{/if}}<span style="color: var(--brand-color);">VIDEOS</span></div>
			<center class="chevron-container">
				<div class="chevron"></div>
				<div class="chevron"></div>
			</center>
		</div>
		<div class="dv-boxes">
			{{#each video}}
				{{#if (eq sSkipVideo false)}}
					{{> dvBoxPartialTemplate this}}
				{{/if}}
			{{/each}}
		</div>
		<div class="general-divider"></div>
	{{/if}}
</script>

<script id="dvBoxPartialTemplate" type="text/x-handlebars-template">
	<div class="dv-box-container">
		<div class="dv-box-top">
			<div class="dv-top-title">{{sMediaName}}</div>
		</div>
		<div class="dv-box-pic">
			<div class="picbox preview" hd-mid="{{nMediaID}}" hd-media="{{sSizes}}" hd-mediaext="{{sExtension}}" hd-mediatype="{{nMediaTypeID}}" {{#if (lt (null2zero nOrigWidth) (null2zero nOrigHeight))}}hd-mediafit {{/if}}
				{{#if (ne @root.payBalance true)}} onclick="showPreview('<iframe src=&quot;{{sUrl}}&quot; frameborder=&quot;0&quot; style=&quot;background: inherit; width: 100%; height: 100%;&quot; allow=&quot;accelerometer; gyroscope; autoplay; encrypted-media; picture-in-picture;&quot; allowfullscreen=&quot;true&quot;></iframe>', {{nMediaID}});"{{/if}}
				>
				<img style="{{#if (eq nStatusID 0)}} opacity: 0.3;{{/if}}" />
				<div class="dv-box-pic-overlay-play">
					<i class="fa-duotone fa-circle-play" style="--fa-primary-color: #000000; --fa-secondary-color: #ffffff; --fa-secondary-opacity: 0.75;"></i>
				</div>
			</div>
		</div>
		{{#if (ne @root.previewOnly true)}}
			{{#if (notnull nMediaID)}}
				<scr{{!}}ipt>
					getVideoLinks($('#vids{{nMediaID}}'), {{nMediaID}});
				</scr{{!}}ipt>
				<div class="dv-vids-container" id="vids{{nMediaID}}">
					<div class="dv-vids"></div>
				</div>
			{{/if}}
		{{/if}}
	</div>
</script>

<script id="downloadfloorplanstemplate" type="text/x-handlebars-template">
	{{#if hasFloorplan}}
		<div class="general-divider"></div>
		<div class="hdr-container">
			<div class="hdr">{{#if (ne previewOnly true)}}DOWNLOAD {{/if}}<span style="color: var(--brand-color);">FLOORPLANS</span></div>
			<center class="chevron-container">
				<div class="chevron"></div>
				<div class="chevron"></div>
			</center>
		</div>
		<div class="df-boxes-container" style="{{#if (and (not hasAttachment) (and previewOnly (or (eq mkUpgradeCost null) (eq marketingKit false))))}}margin-bottom: 3em;{{/if}}">
			<div class="df-boxes">
				{{#each download}}
					{{#if (eq nMediaTypeID 9)}}
						{{> dfloorBoxPartialTemplate this}}
					{{/if}}
				{{/each}}
			</div>
		</div>
	{{/if}}
</script>

<script id="dfloorBoxPartialTemplate" type="text/x-handlebars-template">
	<div class="df-box-container" style="">
		<div class="df-box-pic" style="">
			<div class="picbox preview xdi-box-image" hd-mid="{{nMediaID}}" hd-media="{{sSizes}}" hd-mediaext="{{sExtension}}" hd-mediatype="{{nMediaTypeID}}" {{#if (lt (null2zero nOrigWidth) (null2zero nOrigHeight))}}hd-mediafit {{/if}}style="width: 636px; height: 488px; top: 0; position: absolute;{{#if (eq nStatusID 0)}} opacity: 0.3;{{/if}}"
				{{#if (ne @root.payBalance true)}} onclick="showPreview('<div class=&quot;picbox&quot; hd-media=&quot;{{sSizes}}&quot; hd-mediaext=&quot;{{sExtension}}&quot; hd-mediafit style=&quot;width: 100%; height: 100%;&quot;>{{#if (eq @root.previewOnly true)}}<div><img src=&quot;/art/protected.jpg&quot; class=&quot;protected&quot; /></div>{{/if}}></div>', {{nMediaID}});"{{/if}}
				>
				{{#if (eq @root.previewOnly true)}}<div><img src="/art/protected.jpg" class="protected" /></div>{{/if}}
			</div>
		</div>
		<div class="df-box-middle" style="">
			<div class="df-pic-title">{{truncate sMediaName 100}}</div>
		</div>
		{{#if (ne @root.previewOnly true)}}
			<div class="df-box-bottom" style="">
				<div class="df-dl-link">
				{{#each @root.downloadSizes}}
					<a href="{{#if (eq multiDLID "idpq")}}//media.hd.pics/{{../sOrigMediaKey}}.{{../sExtension}}?filename={{encuri ../sFileName}}.{{../sExtension}}{{else}}sized.aspx?k={{../sOrigMediaKey}}&e={{../sExtension}}&n={{encuri ../sFileName}}.{{../sExtension}}{{singleUrlAppend}}{{/if}}" class="a-single" style="">
					<i class="fak fa-eric-download-arrow-to-bracket" style="color: var(--brand-color); font-size: 1em; margin-right: 0.3em;"></i>
					{{#if (eq multiDLID "idpq")}}
						ORIGINAL SIZE
					{{else}}
						{{title}}
					{{/if}}
					</a>
				{{/each}}
				</div>
			</div>	
		{{/if}}
	</div>
</script>

<script id="downloadattachmentstemplate" type="text/x-handlebars-template">
	{{#if hasAttachment}}
		<div class="general-divider"></div>
		<div class="hdr-container">
			<div class="hdr">{{#if (ne previewOnly true)}}DOWNLOAD {{/if}}<span style="color: var(--brand-color);">ATTACHMENTS</span></div>
			<center class="chevron-container">
				<div class="chevron"></div>
				<div class="chevron"></div>
			</center>
		</div>
		<div class="dat-boxes-container" style="{{#if (and previewOnly (or (eq mkUpgradeCost null) (eq marketingKit false)))}}margin-bottom: 3em;{{/if}}">
			<div class="dat-boxes">
				{{#each attachment}}
					{{#if (eq nMediaTypeID 7)}} <!--Not sure if we need this IF or not yet.. Maybe for Bright?-->
						{{> dattachBoxPartialTemplate this}}
					{{/if}}
				{{/each}}
			</div>
		</div>
	{{/if}}
</script>

<script id="dattachBoxPartialTemplate" type="text/x-handlebars-template">
	<div class="dat-box-container" style="">
		<div class="dat-box-pic" style="">
			<div class="picbox preview" hd-mid="{{nMediaID}}" hd-media="{{sSizes}}" hd-mediaext="{{sExtension}}" hd-mediatype="{{nMediaTypeID}}" {{#if (or (lt (null2zero nOrigWidth) (null2zero nOrigHeight)) (and (eq (null2zero nOrigWidth) 0) (eq (null2zero nOrigHeight) 0)))}}hd-mediafit {{/if}} style="width: 636px; height: 488px; top: 0; position: absolute;{{#if (eq nStatusID 0)}} opacity: 0.3;{{/if}}"
				{{#if (ne @root.payBalance true)}} onclick="window.open('{{mediaurl sOrigMediaKey sExtension}}');"{{/if}}
				>
			</div>
		</div>
		<div class="dat-box-middle" style="">
			<div class="dat-pic-title">{{truncate sMediaName 100}}</div>
		</div>
		{{#if (ne @root.previewOnly true)}}
			<div class="dat-box-bottom" style="">
				<div class="dat-dl-link">
					<a href="//media.hd.pics/{{sOrigMediaKey}}.{{sExtension}}?filename={{encuri sMediaName}}.{{sExtension}}" class="a-single" style="">
					<i class="fak fa-eric-download-arrow-to-bracket" style="color: var(--brand-color); font-size: 1em; margin-right: 0.3em;"></i>
					Download
					</a>
				</div>
			</div>	
		{{/if}}
	</div>
</script>

<script id="embeddedmediatemplate" type="text/x-handlebars-template">
	{{#if embed.length}}
		<div class="hdr-container">
			<div class="hdr"><span style="color: var(--brand-color);">EMBEDDED</span> MEDIA</div>
			<center class="chevron-container">
				<div class="chevron"></div>
				<div class="chevron"></div>
			</center>
		</div>
		<!--<br /><br />-->
		<div class="embed-boxes">
			{{#each embed}}
				{{> emBoxPartialTemplate this}}
			{{/each}}
		</div>
		<div class="general-divider"></div>
	{{/if}}
</script>


<script id="emBoxPartialTemplate" type="text/x-handlebars-template">
	<div class="embed-box-container" style="">
		<div class="embed-box-top" style="">
			<div class="embed-top-title" style="">{{sMediaName}}</div>
		</div>
		<div class="embed-box-pic" style="">
			<a href="{{sUrl}}" target="_blank">
				<div class="embed-box-pic-overlay-play">
					<i class="fa-duotone fa-circle-play" style="--fa-primary-color: #000000; --fa-secondary-color: #ffffff; --fa-secondary-opacity: 0.75;"></i>
				</div>
				<div class="embed-box-pic-overlay-copied-wrapper">
					<div class="embed-box-pic-overlay-copied">
						<i class="fa-sharp fa-regular fa-check" style=""></i>
						<span style="">COPIED TO CLIPBOARD</span>
					</div>
				</div>
				<img {{{sThumbUrl}}} onerror="this.src='/art/url.png'" onload="$(this).parent().find('.embed-box-pic-overlay-play').css('display', 'flex');" style="max-width: 420px; max-height: 236px;" hd-mid="{{nMediaID}}" />
			</a>
		</div>
		{{#if (ne @root.previewOnly true)}}
			<div class="embed-buttons" onclick="window.open('{{zipUrl}}', 'download');">
				{{#if (notnull nVideoMediaID)}}
					<!--<div class="embed-download" onclick="var v = $(this).parent().parent().find('.vids'); if (v.is(':visible')) { v.hide(); } else { getVideoLinks(v, {{nVideoMediaID}}); v.show(); }" style="border-right: 3px solid #F5F5F5;">-->
					<div class="embed-download btn-lite" onclick="var v = $(this).parent().parent().find('.vids'); if (v.is(':visible')) { v.hide(); } else { getVideoLinks(v, {{nVideoMediaID}}); v.show(); }" style="border-right: 3px solid #F5F5F5;">
						<i class="fak fa-eric-download-arrow-to-bracket"></i>
						DOWNLOAD
					</div>
				{{/if}}
				<div class="embed-url btn-lite" onclick="clipboard('{{sUrl}}', this);"{{#if (or (eq (indexof sEmbed "<" 0) 1) (gt (length sEmbed) 0))}} style="border-right: 3px solid #F5F5F5;"{{/if}}>
					<i class="fa-sharp fa-regular fa-link"></i>
					URL
				</div>
				{{#if (or (eq (indexof sEmbed "<" 0) 1) (gt (length sEmbed) 0))}}
					<div class="embed-embed btn-lite" onclick="clipboard('{{sEmbed}}', this);">
						<i class="fa-regular fa-code"></i>
						EMBED
					</div>
				{{/if}}
			</div>
			{{#if (notnull nVideoMediaID)}}
				<div class="vids embed-vids-container">
					<div class="embed-vids"></div>
				</div>
			{{/if}}
		{{/if}}
	</div>
</script>

<script id="copyrighttemplate" type="text/x-handlebars-template">
		{{#if (ne previewOnly true)}}
			{{#if (isnotnull download.[0].sLicense)}}
				{{#if (eq download.[0].nLicensePolicy "0")}}
					<div class="general-divider" style="margin-top: 8em;"></div>
					<div class="hdr-container">
						<div class="hdr">Copyright <span style="color: var(--brand-color);">License</span></div>
						<center class="chevron-container">
							<div class="chevron"></div>
							<div class="chevron"></div>
						</center>
					</div>
					<div class="copyright-container">
						<div class="license-inline" style="">{{newline2br download.[0].sLicense}}<br /><br />Printed {{date}}</div>
						<div class="copyright-btn-container">
							<button class="btn copyright-btn" style="" onclick="printLicense();">> Print Copyright License</button>
						</div>
					</div>
				{{else}}
					<scr{{!}}ipt>
						hd.dialog({
							buttonOK: function () { printLicense(); return false; },
							buttonOKText: 'Print',
							buttonClose: function () { 
								$.ajax('/Media/download2.asp?_{{guid}}'); 
								if($('.marketlink') != undefined)
									$('.marketlink').show().animate({right: '-1px'}, 1250);
							},
							buttonCloseText: 'I Accept',
							content: '<div class="hdr-container-pop"><div class="hdr-pop">Copyright <span style="color: var(--brand-color);">License</span></div><center class="chevron-container"><div class="chevron"></div><div class="chevron"></div></center></div><div class="license" style="border: 1px solid #ddd; padding: 15px 25px; height: 360px; overflow-y: auto;">{{newline2br (replaceall download.[0].sLicense "'" "\'")}}</div>',
							keepscroll: true,
							modal: true,
							height: '590',
							width: '60vw',
							buttonAlign: 'center'
						});
					</scr{{!}}ipt>
				{{/if}}
			{{/if}}
		{{/if}}
</script>

