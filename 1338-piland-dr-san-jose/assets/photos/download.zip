	class BrightMLS extends Widget {
		constructor() {
			super("#brightmlsdiv", "#brightmlstemplate");
		}

		async retrieve() {
			var data = downloadData;

			if (data && data.brightMedia) {
				var foundEmbed = false;
				var foundAttachment = false;

				for (var a = 0; a < data.brightMedia.length; a++) {
					var d = data.brightMedia[a];
					d.firstEmbed = false;
					d.firstAttachment = false;
					if (d.nMediaTypeID == 8 && !foundEmbed) {
						//data.hasBrightEmbeds = true;
						d.firstEmbed = true; //note the first found instance (for creating the title for the section)
						foundEmbed = true;
					}
					if (d.nPDFMode != 3) {
						if (d.nMediaTypeID == 7 && !foundAttachment) {
							d.firstAttachment = true; //note the first found instance (for creating the title for the section)
							foundAttachment = true;
						}
					}
					//if (data.download[a].nMediaTypeID == 8 && !data.download.hasBrightEmbeds) {
					//	data.download.hasBrightEmbeds = true;
					//}
					//if (data.download[a].nPDFMode != 3) {
					//	if (data.download[a].nMediaTypeID == 7 && !data.download.hasBrighAttachments) {
					//		data.download.hasBrighAttachments = true;
					//	}
					//}
				}
			 }


			return data;
		}
	}

	class DownloadAll extends Widget {
		constructor() {
			super("#downloadalldiv", "#downloadalltemplate");
		}

		async retrieve() {
			var data = downloadData;

			data.firstPublicPhoto = null;
			data.secondPublicPhoto = null;
			data.thirdPublicPhoto = null;
			if (data.top3) {
				var count = 0;
				while (count < data.top3.length) {
					if (data.top3[count].nStatusID == 1 && (data.top3[count].nMediaTypeID != 6 || data.top3[count].nLength != null)) {
						if (!data.firstPublicPhoto)
							data.firstPublicPhoto = data.top3[count];
						else if (!data.secondPublicPhoto)
							data.secondPublicPhoto = data.top3[count];
						else {
							data.thirdPublicPhoto = data.top3[count];
							break;
						}
					}
					count++;
				}
			}
			else {
				//failover
				if (data.download) {
					var count = 0;
					while (count < data.download.length) {
						if (data.download[count].nStatusID == 1 && (data.download[count].nMediaTypeID == 1 || data.download[count].nMediaTypeID == 2)) {
							if (!data.firstPublicPhoto)
								data.firstPublicPhoto = data.download[count];
							else if (!data.secondPublicPhoto)
								data.secondPublicPhoto = data.download[count];
							else {
								data.thirdPublicPhoto = data.download[count];
								break;
							}
						}
					count++;
					}
				}
			}

			return data;
		}

		async render(options) {
			await super.render(options);
			hdupdate();
		}
	}

