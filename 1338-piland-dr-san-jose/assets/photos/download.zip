	var registerPartial = (id, selector) => {
		Handlebars.registerPartial(id, $(selector ?? `#${id}`).html());
	}


	////STANDARD LOGIC////
	function brightCheck() {
		var bl = [];
		$('input[name=sBrightMediaList]:checked').each(function (i, o) { bl.push($(o).val()); });
		$('button[name=BrightUpload]').prop('disabled', !bl.length);
	}

	function brightUpload() {
		var bl = [];
		$('input[name=sBrightMediaList]:checked').each(function (i, o) { bl.push($(o).val()); });
		if (bl.length) {
			window.open('/admin/BrightMLS/push.asp?sGuid=A9AE42C520EE473EB8773501D529472E&ml=' + bl.join(','));
		}
		else { return false; }
	}

	function checkCustomDL() {
		var w = ($('input[name=w]').val() != undefined ? $('input[name=w]').val().trim() : '');;

		$('.downallbtn.custom').css({ "opacity": "1.0", "cursor": "pointer" });
		if (w.length > 0 && !isNaN(w)) {
			return true;
		}

		$('.downallbtn.custom').css({ "opacity": "0.3", "cursor": "not-allowed" });
		return false;
	}

	function clicking() {
		if (previewOnly) {
			$('img').bind('contextmenu taphold', hd.nope);
		}
	}

	function clipboard(s, t) {
		if (s) {
			hd.copyToClipboard(s);
			if (t) {
				var play = $(t).parent().parent().find('.embed-box-pic-overlay-play');
				var copied = $(t).parent().parent().find('.embed-box-pic-overlay-copied-wrapper');
				play.hide().delay(2500).show("fade", {}, 1000);
				copied.css('display', 'flex').delay(2000).hide("fade", {}, 1000);
			}
		 }
	}

    function downloadStart() {
        console.log('downloadStart');
        hd.dialog({
            content: '<div style="display: flex; align-items: center; width: ' + (downloadBannerVideo ? 800 : 400) + 'px; max-width: 90vw;">' + 
					'<div style="flex: 1;">' + 
						'<div style="font-size: 1.2em; padding: 2em 2em; text-align: center;">' + 
							'<div class="zip-message">Building ZIP file...</div>' + 
							'<div class="zip-percent"><img src="/art/spinner.gif" style="margin-top: 1em; width: 50px; height: 50px;"></div>' + 
						'</div>' +
					'</div>' +
					(downloadBannerVideo
						?	'<div style="cursor: pointer;" onclick="gotoMarketingKit(true);">' + 
								'<video src="//customer-a2w2ng2dptu8jhre.cloudflarestream.com/9ce926456b84dd0b39f8565d526546d0/downloads/default.mp4" style="min-width: 160px; max-height: 80vh; max-width: calc(min(40vw, 360px)); aspect-ratio: 0.5625; vertical-align: middle; margin: -1em; background: radial-gradient(#fff, #ddd); box-shadow: 0 0 1em #0007;" autoplay muted loop playsinline>' + 
							'</div>' 
						: ''
					) +
				'</div>',
			padding: '0',
            modal: true
        });
	}

    function findPicboxIndex(id) {
        var idx = -1;
        $('.picbox.preview').each(function (i, o) {
            if ($(o).attr('hd-mid') == id) {
                idx = Number(i);
                return false;
            }
        });
        return idx;
    }

	function getCustomUrl() {

		var w = $('input[name=w]').val();
		var h = $('input[name=h]').val();
		var n = $('input[name=n]').val();
		if (n == undefined || n.length == 0) { n = '1338-Piland-Dr'; }

		if (checkCustomDL()) { //at least provide a width
			var dt = new Date();
			var secs = dt.getSeconds() + (60 * (dt.getMinutes() + (60 * dt.getHours())));
			return 'getzip.aspx?g=A9AE42C520EE473EB8773501D529472E&n=' + encodeURIComponent(n) + '[' + w + 'x' + h + '].zip&w=' + w + '&h=' + h + '&jd=' + secs;
		}

		return '';
	}

    function getVideoLinks(o, i) {
		if (!o.hasClass('loaded')) {
			console.log('load vids: ' + i);
			o.addClass('loaded');
			var v = $('> div', o).html('<div style="width: 100%; display: flex; align-content: center; justify-content: center; text-align: center;"><img class="vid-links-loading-img" src="/art/spinner.gif"></div>');
			var funcComplete = function (d) {
				console.log(d);

				if (!o.attr("hd-attempts"))
					o.attr("hd-attempts", 1);
				else {
					var attempts = Number(o.attr("hd-attempts"));
					if (attempts < 6) {
						attempts += 1;
						o.attr("hd-attempts", attempts);
					}
					else {
						if (v[0].tmr) { window.clearTimeout(v[0].tmr); }
						//$('.vid-link-processing-container', o).html('unable to retreive');
						$('.vid-link-processing-container', o).html('');
						return false;
					}
				}

                v.html('');
				if (d && d.download) {
					$(d.download).each(function (ii, oo) { oo.sort = ((oo.quality == 'source') ? 0 : oo.size); });
					for (var a = 0; a < d.download.length - 1; a++) {
						if (d.download[a].sort < d.download[a + 1].sort) {
							var t = d.download[a];
							d.download[a] = d.download[a + 1];
							d.download[a + 1] = t;
							if (a) { a -= 2; } else { a = -1; }
						}
					}
					$(d.download).each(function (ii, oo) {
						if (oo.sort) {
							$('<div class="vid-link-container"><i class="fak fa-eric-download-arrow-to-bracket vid-link-icon"></i><a class="vid-link" href="' + oo.link + '">' + oo.public_name + '</a>' + ((oo.size_short) ? '<span style="font-size: 0.8em;">(' + oo.size_short + ')</span>' : '') + '</div>').appendTo(v);
						}
					});
				 }
				if (d.transcode.status == 'error') {
                    $('<div class="vid-link-error-container"><img class="vid-link-error-img" src="/art/error.png"> TRANSCODE ERROR</div>').appendTo(v);
				}
                else if (d.transcode.status == 'in_progress') {
                    $('<div class="vid-link-processing-container"><img src="/art/spinner.gif" style="width: 1em;"> transcoding...</div>').appendTo(v);
					window.setTimeout(function () { $.ajax({ url: '/media/video.asp?d=' + i, success: funcComplete }); }, 10000);
				}
				if (!d.perm) {
					if (v[0].tmr) { window.clearTimeout(v[0].tmr); }
					v[0].tmr = window.setTimeout(function () { v.html(''); o.removeClass('loaded').hide(); }, 7200000);
				}
            }
            $.ajax({ url: '/media/video.asp?d=' + i, success: funcComplete });
        }
	}
	
	function gotoMarketingKit(newTab) {
		//allows us the logic/ability to choose which MK they go to based on BO settings and timing.
		if (downloadData && downloadData.siteId) {
			if (newTab) {
				window.open('/Media/marketingkit2.asp?A9AE42C520EE473EB8773501D529472E');
			} 
			else {
				location.href = '/Media/marketingkit2.asp?A9AE42C520EE473EB8773501D529472E';
			}
		}
	}

	function keyDown(k) {
        if (previewing) {
            if (k.keyCode == 27) { previewClose(); }
            if (k.keyCode == 37) { previewMovePrev(); }
            if (k.keyCode == 39) { previewMoveNext(); }
        }
    }

