	////HANDLEBARS LOGIC////
	var templates = {};
	//'get compiled templates with cache support
	var getTemplate = (id) => {
		var rval = templates[id];
		if ($(id).length == 0)
			throw new Error(`Template ${id} is missing`);
		if (rval === undefined) {
			console.log(`compiling ${id} template`);
			rval = Handlebars.compile($(id).html());
			templates[id] = rval;
		} else {
			//console.log(`${id} already cached`);
		}

		return rval;
	};

	var renderTemplate = (template, context) => {
		var compiledTemplate = getTemplate(template);
		return compiledTemplate(context);
	};
    
	var renderWithHandlebars = (target, template, context) => {
		var rendered = renderTemplate(template, context);
		$(target).html(rendered);
		hd.picbox_init($(target));
	};

	var logHandlebarsParsingError = function(err, html) {
		var genericParseError = () => {
			var tmp = err.message.match(/Parse error on line (\d+)/);
			if (tmp?.length > 1) {
				var line = tmp[1];
				var lines = html.split("\n");
				console.log(`Handlebars Parsing error on line ${line}: ${lines[line-1]}`);
				console.log(html);
				return true;
			} else {
				tmp = err.message.match(/.*(\d+):(\d+)/);
				if (tmp?.length > 1) {
					line = tmp[1];
					lines = html.split("\n");
					console.log(`Handlebars Parsing error on line ${line}: ${lines[line-1]}`);
					console.log(html);
					return true;
				}
			}
		};
		var ifParseError = () => {
			var tmp = err.message.match(/if doesn't match else - (\d+):(\d+)/);
			if (tmp?.length > 1) {
				var line = tmp[1];
				var lines = html.split("\n");
				console.log(`Handlebars Parsing error on line ${line}: ${lines[line-1]}`);
				console.log(html);
				return true;
			}
		};

		done = genericParseError();
		if (!done) done = ifParseError();
	}

	Handlebars.registerHelper("isMobile", () => {
	    //return mobileGrids();
		return ($(window).width() < 770) || hd.isMobile();
	});


	var firstRender = true;
	//var mobileGrids = () => {
	//	return ($(window).width() < 770) || hd.isMobile();
	//}

	var hdupdate = () => {
		hd.required_init();
		hd.texthint_init();
		hd.truncate_init();
		hd.stripPhone();
		//hd.mobileGrid();
	};

	class Download {
		#widgets = [];
		constructor(usertypeid, previewOnly) {
			this.usertypeid = usertypeid;
			this.previewOnly = previewOnly;
			$(".widget").hide(); 
		}

		init() {
			$(".widget").hide(); 
			//$("div[type='text/x-handlebars-template']").hide();
			this.#widgets.forEach(w=> {w.init(); w.hide();});
		}

		async render() {
			this.#widgets.forEach(async w => {
				try {
					await w.render()
				} catch(err) {
					console.error(err);
				}
			});
			hdupdate();
		}

		register(widget) {
			this.#widgets.push(widget);
		}
	}

	class Widget {
		//private
		#spinner = '<div class="shimmer"></div>';
		#dataTarget = null;

		//protected
		_div = null;
		_options = null;
		_template = null;

		constructor(divSelector, templateSelector, options) {
			this.divSelector = divSelector;
			this.templateSelector = templateSelector;
			let partials = this._partials();
			if (partials) {
				if (Array.isArray(partials)) {
					partials.forEach(a=> registerPartial(a));
				} else
					registerPartial(partials);
			}
			this._template = getTemplate(templateSelector);
			this._div = $(divSelector);
			this._options = options ?? {};

			var dt = $(".datatarget", this._div);
			if (dt.length > 1) {
				throw new Error(`Resolved multiple data targets`);
			} else if (!dt.length) {
				//default to the div itself
				this._dataTarget = this._div;
			} else {
				this._dataTarget = dt;
				dt.hide();
			}
		}

		//optional list of handlebars partials to register
		_partials() { return null;}

		init() {
			var t = getTemplate(this.templateSelector);
			if (!t)
				throw new Error(`Handlebars template ${templateSelector} is missing`);
		}

		_addSpinner() { this._div.append(this.#spinner); }
		_removeSpinner() { $(".shimmer", this._div).remove(); hd.resize(); }

		hide() {
			this._div.hide();
		}

		show() {
			this._div.show();
		}

		refreshOn(key) {
			//this would need to be overridden inside any concrete widget to determine the behavior
			return false;
		}

		updateOption(key, val) {
			this._options[key] = val;
		}

		async render(renderoptions) {
			this.show();
			this._addSpinner();

			var data = await this.retrieve(this._options);
			if (data) {
				try {
					var content = this._template(data);
                
					//replace the datatarget completely
					if (this._dataTarget.hasClass('replaceme')) {
						var newdt = $(content)
						this._dataTarget.replaceWith(newdt);
						this._dataTarget = newdt;
					} else {
						this._dataTarget.html(content);
					}
					hd.picbox_init(this._dataTarget)
					this._dataTarget.show();
				} catch (err) {
					var html = $(this.templateSelector).html()
					logHandlebarsParsingError(err, html);
					throw err;
				}
			} else { //no data
				this.hide();
			}

			this._removeSpinner();

			return data;
		}

		async retrieve(options) {
			throw new Error("This method must be overridden");
		}
    
		getOptions() {
			return this._options;
		}
	}

	class BannerHead extends Widget {
		constructor() {
			super("#bannerheaddiv", "#bannerheadtemplate");
		}

		async retrieve() {
			var data = downloadData;

			data.firstPublicPhoto = null;
			if (data.top3) {
				var count = 0;
				while (count < data.top3.length) {
					if (data.top3[count].nStatusID == 1 && (data.top3[count].nMediaTypeID != 6 || data.top3[count].nLength != null)) {
						data.firstPublicPhoto = data.top3[count];
						break;
					}
					count++;
				}
			}
			else {
				//failover
				if (data.download) {
					var count = 0;
					while (count < data.download.length) {
						if (data.download[count].nStatusID == 1 && (data.download[count].nMediaTypeID == 1 || data.download[count].nMediaTypeID == 2)) {
							data.firstPublicPhoto = data.download[count];
							break;
						}
						count++;
					}
				}
			}
			return data;
		}
	}

