				if (dd.sSizes != null) {
					d.hasPhoto = true;
				}

				var mn = 'Photo ' + dd.nMediaID;
				if (dd.sMediaName != null && dd.sMediaName.length) {
					mn = dd.sMediaName.trim();
				}
				dd.sMediaName = mn; //set (potentially updated) sMediaName

				var fn = safeFileName(mn);
				if (!fn.length) { 'Photo ' + dd.nMediaID; }

				//increment if needed (filename overlap protection)
				mnList += '<' + fn + '>';
				var count2 = mnList.split('<' + fn + '>').length - 1;
				fn += ((count2 > 1) ? ' (' + count2 + ')' : '');

				dd.sFileName = fn;

				if (!d.hasFloorplan && dd.nMediaTypeID == 9) {
					d.hasFloorplan = true;
				}
			}
		}

		//prep a new property for the videos and default them
		for (var b = 0; b < d.video.length; b++) {
			d.video[b].sSkipVideo = false;
		}

		//prep embedThumbLinks
		if (d.embed) {
			for (var a = 0; a < d.embed.length; a++) {
				d.embed[a].sThumbUrl = hd.embedThumbEx2(d.embed[a].sUrl, (d.embed[a].sTime != null ? d.embed[a].sTime : ''), '420', '236');
				d.embed[a].sEmbed = hd.embedCode(hd.fixVideoUrl(d.embed[a].sUrl));

				d.embed[a].nVideoMediaID = null;
				if (d.video) {
					for (var b = 0; b < d.video.length; b++) {
						if (d.video[b].sUrl != null && (d.video[b].sUrl + '?').split('?')[0] == d.embed[a].sUrl) {
							if (d.video[b].sExtension != null && d.video[b].sExtension.toLowerCase() != 'url') {
								d.video[b].sSkipVideo = true;
								d.embed[a].nVideoMediaID = d.video[b].nMediaID;
								break;
							}
						}
					}
				}
			}

			if (d.video) {
				for (var b = 0; b < d.video.length; b++) {
					if (d.video[b].sSkipVideo == false) {
						d.hasVideo = true;
						break;
					}
				}
			}
		}

		return d;
	}

    function previewClose() {
        $('.dialog-details').stop(true, false).animate({ opacity: 0 }, 500, function () { $(this).hide(); $('.dialog-details .previewimage').html(''); });
        mIndex = -1;
        previewing = false;
    }

    function previewMoveNext() {
        mIndex += 1;
        if (mIndex >= ($('.picbox.preview').length)) {
            previewing = false;
            hd.dialog_close();
        }
        else {
            $('.picbox.preview')[mIndex].click();
        }
    }

    function previewMovePrev() {
        mIndex -= 1;

        if (mIndex < 0) {
            previewing = false;
            hd.dialog_close();
        }
        else {
            $('.picbox.preview')[mIndex].click();
        }
	}

    function printLicense() {
        var pwin = window.open('', '', 'top=' + (window.screenTop + 20) + ',left=' + (window.screenLeft + 20) + ',width=' + ($(window).outerWidth() - 40) + ',height=' + ($(window).outerHeight() - 40));
        pwin.document.write('<html><head><title>Copyright License</title>');
		pwin.document.write('</head><body onload="window.print(); window.close();">');
		if ($('.license').length) {
			pwin.document.write($('.license').html());
		}
		else {
			pwin.document.write($('.license-inline').html());
		}
        pwin.document.write('</body></html>');
        pwin.document.close();
        pwin.focus();
    }

	function resize() {
		//set the correct current width of the Selected Photos download (to match the photo section above it)
		/*$('.di-dl-selected-container').width(Math.min($('.di-boxes').width(), $(window).width()));*/

		//fix images
		var ww = $(window).width();
		var daboxes = $('.da-box-container');
		var boxwidth = daboxes.width() * Math.max(1, Math.min(daboxes.length, Math.floor(ww / daboxes.width())));
		var mkwt = $('.mkit-widget-title').width();
		var ml = Math.max((boxwidth - mkwt - 390) / 2, 0);

		if ((ww - boxwidth) > 400) {
			$('.mkit-widget-container').removeClass('small').css('margin-left', ml).show();
		}
		else if ((ww - mkwt) > 510) {
			$('.mkit-widget-container').addClass('small').css('margin-left', 0).show();
		}
		else {
			$('.mkit-widget-container').hide();
		}

		var bp = $('.banner-bg.picbox'); //fix banner width
		if (bp.length) {
			bp.css({ 'width': ww + 'px' });
			bp.picboxprocessed = false;
			hd.picbox_process(bp); //re-process
		}

		var upb = $('.picbox', $('.banner-user-photos')); //user photos
		if (upb.length) { //are there user picboxes
			for (var a = 0; a < upb.length; a++) {
				var ubw = $(upb[a]).width();
				var ubh = $(upb[a]).height();
				var lw = $(upb[a]).attr('hd-lastwidth');
				var lh = $(upb[a]).attr('hd-lastheight');
				if (lw == undefined || lw != ubw || lh == undefined || lh != ubh) {
					$(upb[a]).attr('hd-lastwidth', ubw).attr('hd-lastheight', ubh);
					$(upb[a]).picboxprocessed = false;
					hd.picbox_process($(upb[a])); //re-process
				}
			}
		}

		var list = ['.di', '.dv', '.df', '.embed', '.dat']; //individual photos, videos, floorplans, embeds, attachments
		for (var i = 0; i < list.length; i++) {
			var bt = $(list[i] + '-box-pic');
			if (bt.length) {
				for (var a = 0; a < bt.length; a++) {
					var max = bt.parent($(list[i] + '-box-container')).css('max-width'); //find what the OG width
					max = ((max == undefined) ? (i ? 316 : (i == 1 ? 508 : 336)) : max.replace('px', '')); //should always have them but just in case... also remove the 'px' to make it numeric
					max = Math.min(ww, max); //if the window width is smaller than the OG width, use it instead

					var cpb = $('.picbox', bt[a]);
					if (cpb.length) { //is it a picbox?
						var pbw = cpb.width();
						var pbh = cpb.height();
						var pbr = pbw / pbh;

						$(bt[a]).css('height', Math.round(max / pbr) + 'px'); //fix height of the box top
						cpb.css({ 'width': max + 'px', 'height': Math.round(max / pbr) + 'px' }); //fix current picbox x/y
						cpb.picboxprocessed = false;
						hd.picbox_process(cpb); //re-process
					}
					else { //embed doesn't use picbox, but their own embed url
						var ci = $('img', bt[a]);
						var id = ci.attr('hd-mid'); //grab the hd-mid attribute off of the img element

						if (ci.attr('src') != '' && !ci.width()) { //is the thumbnail ready for the calculations?
							window.setTimeout('resize()', 100)
							break;
						}

						var cw = ci.width();
						var ch = ci.height();
						var cr = cw / ch;

						$(bt[a]).css('height', Math.round(max / cr) + 'px'); //fix height of the box top
						if (id != undefined) {
							if (downloadData.embed) {
								var newurl = null;
								for (var j = 0; a < downloadData.embed.length; j++) {
									if (downloadData.embed[j].nMediaID == id) {
										newurl = hd.embedThumbEx2(downloadData.embed[j].sUrl, (downloadData.embed[j].sTime != null ? downloadData.embed[j].sTime : ''), max, Math.round(max / cr)); //get updated current img size
										//console.log(Math.round(max / btr));
										if (newurl && newurl != undefined) {
											if (newurl.indexOf('src="') > -1) {
												newurl = newurl.substr(5, (newurl.length - 6));
											}
											if (newurl != ci.attr('src')) {
												//don't bother re-polling for non-src images (abnormal i.e. vimeo)
											}
										}
										break;
									}
								}
							}
						}
						ci.css({ 'width': max + 'px', 'height': Math.round(max / cr) + 'px' }); //fix current image size (regardless of if it found an updated thumb or not)
						//fix overlays
						var op = $('.embed-box-pic-overlay-play', bt[a]);
						if (op != undefined) {
							op.css('height', Math.round(max / cr) + 'px'); //fix height of the box "copied" overlay
						}

						var cpw = $('.embed-box-pic-overlay-copied-wrapper', bt[a]);
						if (cpw != undefined) {
							cpw.css('height', Math.round(max / cr) + 'px'); //fix height of the box "copied" overlay
						}
					}
				}
			}
		}
	}

	function safeFileName(f) {
		if (f != undefined && f != null) {
			f.trim();
			f.replace(/[\\\/:\*\?\"<\>\|#]+/g, '_');
			f.replace(/[^\x20-\x7E]+/g, '_');
		 }

		return f;
	}

    function showPreview(c, id) {
        mIndex = findPicboxIndex(id);
        hd.dialog({
            afterClose: function () { $('.hd-dialog-container').remove(); },
            content: '<table class="dialog-wrapper" style="height: 100%;"><tr>' +
                '<td class="dialog-prev dialog-paddle nosel" style="width: 48px;" onmousedown="previewMovePrev();"><img src="/art/left_white.png" style="padding: 0 8px; width: 32px; height: 60px;"></td>' +
                '<td class="dialog-details" style="width: 100%; height: 100%; position: relative; overflow: hidden;">' + c + '</td>' +
                '<td class="dialog-next dialog-paddle nosel" style="width: 48px;" onmousedown="previewMoveNext();"><img src="/art/right_white.png" style="padding: 0 8px; width: 32px; height: 60px;"></td>' +
                '</tr></table>',
            closer: true,
            padding: '0',
            height: 'calc(100% - 50px)',
            width: 'calc(100% - 50px)'
        });
        previewing = true;
		hd.picbox_init($('.dialog').css({ background: 'none', border: 0, boxShadow: 'none' }));
    }

	function updateCheckbox() {
		var l = $('input[name=nMediaID]:checked').length;
		/*console.log('updateCheckbox', l);*/

		if (l == 0) {
			/*$('.downselbtn').css({ opacity: 0.3, cursor: 'not-allowed' });*/
			$('.downselbtn').addClass('disabled');
			if (l == 0 && diSelHudOpen) { diSelHudOpen = false; $('.di-dl-selected-container').animate({ bottom: -100, opacity: 0 }, function () { $(this).hide(); }); }
		}
		else {
			/*$('.downselbtn').css({ opacity: 1.0, cursor: 'pointer' });*/
			$('.downselbtn').removeClass('disabled');
            if (l > 0 && !diSelHudOpen) { diSelHudOpen = true; $('.di-dl-selected-container').css({ bottom: -100, opacity: 0 }).show().animate({ bottom: -20, opacity: 1 }); }
		}
	}

    function zipFallback(u) {
        if (u) {
            document.zipFallbackTimer = window.setTimeout(function () { console.log('USING FALLBACK: ' + u); $('iframe[name=download]').attr('src', u); }, 15000);
        }
        else {
            window.clearTimeout(document.zipFallbackTimer);
        }
    }

    function zipFinish(u) {
        console.log('zipFinish: ' + u);
        $('iframe[name=download]').attr('src', u);
		$('.zip-message').html('Zip file download started.<br />Check your download folder.')
		$('.zip-percent').html('<br><button class="btn" onClick="hd.dialog_close()">Close</button>')
		//window.setTimeout(hd.dialog_close, 2000);
    }

	function zipSelected(zipSelUrl) {
		var ml = [];
		$('input[name=nMediaID]:checked').each(function (i, o) { ml.push($(o).val()); });
		if (ml.length) {
			downloadStart();
			$('iframe[name=download').attr('src', zipSelUrl.replace('[[replace]]', ml.join(',')));
		}
		else {
			return false;
		}
	}

    function zipUpdate(m, p) {
        console.log('zipUpdate: ' + m + ' / ' + p);
        $('.zip-message').html(m);
        $('.zip-percent').html('<div style="background: #eee; border: 1px solid #888; border-radius: 5px; margin: 1em auto 0 auto; padding: 1px; width: 200px; max-width: calc(100vw - 260px);"><div style="background: var(--brand-color); border-radius: 4px; width: ' + Number((p / 1) * 100).toFixed(2) + '%; height: 10px;"></div></div>');
    }



